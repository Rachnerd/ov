{
  "name": "@ov/ui-components-angular",
  "version": "1.0.0",
  "main": "./dist/fesm2022/ov-ui-components-angular.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/ov-ui-components-angular.mjs"
    },
    "./atoms/*": {
      "types": "./dist/atoms/*/index.d.ts",
      "default": "./dist/fesm2022/ov-ui-components-angular-atoms-*.mjs"
    },
    "./molecules/*": {
      "types": "./dist/molecules/*/index.d.ts",
      "default": "./dist/fesm2022/ov-ui-components-angular-molecules-*.mjs"
    },
    "./organisms/*": {
      "types": "./dist/organisms/*/index.d.ts",
      "default": "./dist/fesm2022/ov-ui-components-angular-organisms-*.mjs"
    },
    "./templates/*": {
      "types": "./dist/templates/*/index.d.ts",
      "default": "./dist/fesm2022/ov-ui-components-angular-templates-*.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-wrappers.mjs",
    "build": "ng-packagr -p ng-package.json",
    "test": "jest"
  },
  "peerDependencies": {
    "@angular/common": ">=20",
    "@angular/core": ">=20",
    "@ov/ui-components": "*"
  },
  "devDependencies": {
    "@angular/common": "^20.3.19",
    "@angular/compiler": "^20.3.19",
    "@angular/compiler-cli": "^20.3.19",
    "@angular/core": "^20.3.19",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^14.6.2",
    "ng-packagr": "^20.0.0",
    "ts-jest": "^29.4.9"
  }
}
