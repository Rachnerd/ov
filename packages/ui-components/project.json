{
  "name": "@ov/ui-components",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm run analyze",
          "npm run build",
          "npm run build-storybook"
        ],
        "parallel": true,
        "cwd": "packages/ui-components"
      }
    },
    "test": {
      "command": "npm run test",
      "options": {
        "cwd": "packages/ui-components"
      }
    },
    "start": {
      "command": "npm start",
      "options": {
        "cwd": "packages/ui-components"
      }
    }
  }
}
