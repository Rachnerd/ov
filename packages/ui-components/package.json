{
  "name": "@ov/ui-components",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist/src/atoms/",
    "dist/src/organisms/",
    "dist/src/molecules/",
    "dist/src/templates/"
  ],
  "exports": {
    "./atoms/*": {
      "import": "./dist/src/atoms/*",
      "types": "./dist/src/atoms/*"
    },
    "./organisms/*": {
      "import": "./dist/src/organisms/*",
      "types": "./dist/src/organisms/*"
    },
    "./molecules/*": {
      "import": "./dist/src/molecules/*",
      "types": "./dist/src/molecules/*"
    },
    "./templates/*": {
      "import": "./dist/src/templates/*",
      "types": "./dist/src/templates/*"
    }
  },
  "typesVersions": {
    "*": {
      "atoms/*": [
        "dist/src/atoms/*"
      ],
      "organisms/*": [
        "dist/src/organisms/*"
      ],
      "molecules/*": [
        "dist/src/molecules/*"
      ],
      "templates/*": [
        "dist/src/templates/*"
      ]
    }
  },
  "sideEffects": true,
  "customElements": "custom-elements.json",
  "scripts": {
    "start": "storybook dev -p 6006 --config-dir .storybook",
    "prod": "npm run build-storybook && npx live-server storybook-static --port=6006",
    "analyze": "cem analyze",
    "build": "tsc -p tsconfig.build.json",
    "test": "wtr --config web-test-runner.config.mjs --fail-on-unhandled-errors",
    "test:watch": "wtr --config web-test-runner.config.mjs --watch",
    "storybook": "npm run analyze && storybook dev -p 6006 --config-dir .storybook",
    "build-storybook": "npm run analyze && storybook build --config-dir .storybook"
  },
  "peerDependencies": {
    "@ov/style": "*",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^4.0.0",
    "@ov/style": "*",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/web-components": "^8.6.18",
    "@storybook/web-components-vite": "^8.6.18",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "lit": "^3.1.2",
    "storybook": "^8.6.18"
  }
}
