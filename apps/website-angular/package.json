{
  "name": "website-angular",
  "version": "1.0.0",
  "scripts": {
    "prod": "npm run build && npx live-server dist/website-angular/browser --port=3001",
    "build": "ng build --configuration production",
    "start": "ng serve -o",
    "stats": "ng build --configuration production --stats-json && esbuild-visualizer --metadata dist/website-angular/stats.json && open stats.html",
    "test": "jest"
  },
  "dependencies": {
    "@angular/animations": "^19.2.21",
    "@angular/common": "^19.2.21",
    "@angular/compiler": "^19.2.21",
    "@angular/core": "^19.2.21",
    "@angular/platform-browser": "^19.2.21",
    "@angular/platform-browser-dynamic": "^19.2.21",
    "@angular/router": "^19.2.21",
    "@ov/style": "file:../../packages/style/dist",
    "@ov/ui-components-angular": "file:../../packages/ui-components-angular/dist",
    "@ov/ui-components": "file:../../packages/ui-components/dist",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^19.2.24",
    "@angular/cli": "^19.2.24",
    "@angular/compiler-cli": "^19.2.21",
    "@types/jest": "^29.5.14",
    "esbuild-visualizer": "^0.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "ts-jest": "^29.4.9",
    "typescript": "~5.8.3"
  }
}
